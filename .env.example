# 管理后台。ADMIN_PASSWORD 至少 15 字符并避免常见/重复模式；
# SESSION_SECRET 至少 32 位且应使用密码生成器创建的随机值。
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# SQLite 数据库位置。Docker 部署建议保持 /app/data/isme.db。
ISME_DATABASE_PATH=./data/isme.db

# CogDoc FastAPI 地址。留空时启用不含个人数据的演示模式。
COGDOC_API_URL=

# CogDoc 配置 COGDOC_API_KEYS 后，在这里放其中一个 Key。仅服务端可见。
COGDOC_API_KEY=

# 单次问答超时，单位毫秒。
COGDOC_TIMEOUT_MS=90000

# 站点的公开地址，用于 SEO canonical 和分享卡片。
# 公网生产部署必须使用 https://；下面的 HTTP 值仅供本地开发/验收。
SITE_URL=http://localhost:3000

# 可选：限制管理后台与 /api/admin 的来源 IP（逗号分隔）。留空=不限制。
# Docker/nginx 会覆盖 X-Forwarded-For / X-Real-IP 为真实连接 IP；应用优先读 X-Real-IP。
ADMIN_IP_ALLOWLIST=

# 可选：S3 兼容对象存储（R2 / MinIO / AWS S3）。三者都填才启用；留空则用本地 public/uploads。
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=isme
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 浏览器可访问的公开前缀（CDN / 自定义域 / bucket 公网 URL）
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# MinIO 等通常需要 path-style：S3_FORCE_PATH_STYLE=true
# S3_FORCE_PATH_STYLE=false

# HTTPS（docker-compose.https.yml）初始化时使用：
# DOMAIN=example.com
# CERTBOT_EMAIL=you@example.com
# CERTBOT_STAGING=0
